# ---------------------------------------------------------------------------
# Instagram accounts (rotation supports up to 2; leave 2 empty for single)
# ---------------------------------------------------------------------------
IG_USERNAME_1=
IG_PASSWORD_1=
IG_2FA_SECRET_1=
IG_HANDLE_1=@xene.ai

IG_USERNAME_2=
IG_PASSWORD_2=
IG_2FA_SECRET_2=
IG_HANDLE_2=

# ---------------------------------------------------------------------------
# LLM — unique line + caption generation (Gemini, OpenAI-compatible endpoint)
# Copy these from the other project's secrets if you already have them.
# Leave LLM_API_KEY empty to run purely from the built-in seed bank.
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash

# ---------------------------------------------------------------------------
# Cadence guards (protect the accounts)
# ---------------------------------------------------------------------------
DAILY_CAP_PER_ACCOUNT=6
MIN_GAP_MINUTES=120

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Discord/Slack webhook for failure alerts
NOTIFY_WEBHOOK_URL=
# Set to 1 to pause all publishing without touching the workflow
KILL_SWITCH=0
# Set to 1 to build-but-never-publish everywhere
DRY_RUN=0
# Override binary locations if ffmpeg/ffprobe are not on PATH
# FFMPEG_BIN=
# FFPROBE_BIN=
# Random seed for reproducible runs (leave empty for true randomness)
RANDOM_SEED=
