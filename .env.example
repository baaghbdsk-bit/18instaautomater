# ---------------------------------------------------------------------------
# Instagram accounts (rotation supports up to 2; leave 2 empty for single)
# ---------------------------------------------------------------------------
IG_USERNAME_1=
IG_PASSWORD_1=
IG_2FA_SECRET_1=
IG_HANDLE_1=@xene.ai

IG_USERNAME_2=panda_fcuk
# Both accounts share the same password (fill with the IG_PASSWORD_1 value)
IG_PASSWORD_2=
IG_2FA_SECRET_2=
IG_HANDLE_2=@panda_fcuk

# ---------------------------------------------------------------------------
# LLM — unique line + caption generation (Gemini, OpenAI-compatible endpoint)
# Copy these from the other project's secrets if you already have them.
# Leave LLM_API_KEY empty to run purely from the built-in seed bank.
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash

# ---------------------------------------------------------------------------
# Cadence guards (protect the accounts)
# ---------------------------------------------------------------------------
DAILY_CAP_PER_ACCOUNT=6
MIN_GAP_MINUTES=0

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Discord/Slack webhook for failure alerts
NOTIFY_WEBHOOK_URL=
# Set to 1 to pause all publishing without touching the workflow
KILL_SWITCH=0
# Set to 1 to build-but-never-publish everywhere
DRY_RUN=0
# Override binary locations if ffmpeg/ffprobe are not on PATH
# FFMPEG_BIN=
# FFPROBE_BIN=
# Random seed for reproducible runs (leave empty for true randomness)
RANDOM_SEED=

# ---------------------------------------------------------------------------
# Curated quote bank (approved lines; no LLM filler)
# ---------------------------------------------------------------------------
# Path to the JSON bank. Default: assets/quotes/approved.json
# QUOTE_BANK_PATH=
# Warn when fewer than this many unused approved lines remain
QUOTE_LOW_WATERMARK=20

# ---------------------------------------------------------------------------
# Image generation provider (modular adapter)
# ---------------------------------------------------------------------------
# One of: perchance | nvidia | placeholder (placeholder = DEV/TEST ONLY)
IMAGE_PROVIDER=perchance
# Local Perchance-API wrapper (no API key):
#   git clone https://github.com/afrozthalam/Perchance-API.git
#   pip install -r Perchance-API/requirements.txt
#   python Perchance-API/app.py
PERCHANCE_URL=http://127.0.0.1:8000
PERCHANCE_STYLE=Cinematic
PERCHANCE_ASPECT=512x768
PERCHANCE_GUIDANCE=7
PERCHANCE_TIMEOUT=240
PERCHANCE_RETRIES=2
# Perchance exposes NO reference-image/identity field. A fixed seed does NOT
# guarantee the same face. See README for the honest limitation.
# Optional alternative (reference-image capable providers require your own key):
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_TIMEOUT=300
# Set to 1 ONLY for local development; production refuses placeholders.
ALLOW_PLACEHOLDER=0

# ---------------------------------------------------------------------------
# Character identity
# ---------------------------------------------------------------------------
CHARACTER_ID=meera-v1

# ---------------------------------------------------------------------------
# Instagram catalog music on photo posts (instagrapi >= 3.2)
# ---------------------------------------------------------------------------
# Attach a TRENDING audio track from Instagram's catalog to each photo post.
MUSIC_ENABLED=1
# trending = top trends | search = query below | off = no music
MUSIC_SOURCE=trending
MUSIC_SEARCH_QUERY=trending
MUSIC_TRENDING_PRODUCT=music_in_feed
MUSIC_LIMIT=10

# ---------------------------------------------------------------------------
# Reel output (default): the composed quote image becomes a short MP4
# ---------------------------------------------------------------------------
REEL_DURATION=12
REEL_MOTION=push_center
